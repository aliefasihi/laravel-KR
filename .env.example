APP_NAME="Khaneh Romantic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://khanehromantic.test

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# `php artisan serve` handles one request at a time unless this is set (Linux/macOS only;
# on Windows use Laravel Herd or Laragon instead of artisan serve). See docs/PERFORMANCE.md.
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=khanehromantic
DB_USERNAME=khanehromantic
DB_PASSWORD=

# Local: file is fastest. Production: redis for session, cache and queue (docs/PERFORMANCE.md).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Khaneh Romantic -------------------------------------------------------
# Must match the live WordPress category base (Settings → Permalinks).
KHANEH_CATEGORY_PREFIX=product-category

# --- WordPress import source (read-only) ----------------------------------
WP_BASE_URL=https://khanehromantic.com
WP_DB_DRIVER=mysql
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_DATABASE=wordpress
WP_DB_USERNAME=root
WP_DB_PASSWORD=
WP_DB_PREFIX=wp_
# Socket file (Local by Flywheel / MAMP); when set, host/port are ignored
WP_DB_SOCKET=
# WooCommerce currency: IRT (Toman) or IRR (Rial)
WP_CURRENCY=IRT
# Old wp-content/uploads folder on this server (optional; otherwise images are downloaded)
WP_UPLOADS_PATH=
# (ORDER_NUMBER_OFFSET below: new order numbers continue after the imported ones)

# ── Search (modules/Search/README.md) ──────────────────────────────
# database | meilisearch | elasticsearch   (unreachable engine → database fallback)
SEARCH_DRIVER=database
SEARCH_INDEX=khaneh_products
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
ELASTICSEARCH_HOST=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=

# ── SEO: redirect suggestions for old WordPress URLs ───────────────
SEO_SUGGEST_MIN_SCORE=0.6
# 1 = an exact SKU match in the old URL becomes a 301 without review; empty = always review
SEO_AUTO_REDIRECT_SCORE=

# ── SMS (login codes, order messages) — also editable in پنل ← تنظیمات فروشگاه ← پیامک ──
# log = codes only go to storage/logs/laravel.log (local); kavenegar | smsir for the live site
SMS_DRIVER=log
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=login
KAVENEGAR_SENDER=
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE=
SMSIR_OTP_PARAMETER=CODE
SMSIR_LINE=
# WebOTP (Android fills the code by itself): the SMS template's last line = "@khanehromantic.com #code"
OTP_WEBOTP_DOMAIN=khanehromantic.com

# ── Web push (php artisan push:keys) — empty: made once in storage/app/private/webpush.json
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=

# ── Payments (also editable in پنل ← تنظیمات فروشگاه ← پرداخت) ───────
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
# Orders
ORDER_NUMBER_OFFSET=100000
ORDER_HOLD_MINUTES=30
