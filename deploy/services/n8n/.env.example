# n8n settings — copy to /srv/services/n8n/.env (chmod 600). | نویسنده: علی فصیحی (Ali Fasihi)
N8N_DOMAIN=n8n.khanehromantic.com
# make once with: openssl rand -hex 32 — and keep a copy: without it the saved credentials can't be read
N8N_ENCRYPTION_KEY=
# e.g. 1.123.4 — https://github.com/n8n-io/n8n/releases
N8N_VERSION=latest
