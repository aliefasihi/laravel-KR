# Khaneh Romantic — .env for the server. Copied to /srv/khanehromantic/shared/.env (chmod 600, owner khaneh).
# نویسنده: علی فصیحی (Ali Fasihi)
# Values in <…> are filled in by the guide (section 13). Never put this file in git.

APP_NAME="Khaneh Romantic"
APP_ENV=production
# made once by the guide (section 13) — ✱ never change it later (panel secrets are encrypted with it)
APP_KEY=
APP_DEBUG=false
# first the test address, after the DNS switch https://khanehromantic.com (section 15)
APP_URL=https://<DOMAIN>

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=khanehromantic
DB_USERNAME=khanehromantic
DB_PASSWORD=<DB_PASSWORD>

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=redis
QUEUE_CONNECTION=redis
# longer than the longest job (image versions: 120 s); the worker stops a job after 240 s
REDIS_QUEUE_RETRY_AFTER=300

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@khanehromantic.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Khaneh Romantic ──
KHANEH_CATEGORY_PREFIX=

# Search: the database is enough for today's catalogue; Meilisearch later as a service (section 18)
SEARCH_DRIVER=database
SEARCH_INDEX=khaneh_products

# WordPress import (section 14); the dump is loaded with `php artisan wp:import:load`
WP_BASE_URL=https://khanehromantic.com
WP_CURRENCY=IRT
WP_UPLOADS_PATH=

# SMS — or in the panel: تنظیمات فروشگاه ← پیامک
SMS_DRIVER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=login
KAVENEGAR_SENDER=
OTP_WEBOTP_DOMAIN=khanehromantic.com

# Web push: leave empty — the site makes its keys once in storage/app/private/webpush.json (in the nightly backup)
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=

# Payments — or in the panel: تنظیمات فروشگاه ← پرداخت
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# above the last WooCommerce order number (section 14)
ORDER_NUMBER_OFFSET=100000
ORDER_HOLD_MINUTES=30
